{
  "name": "getfullpage",
  "version": "2.1.0",
  "private": true,
  "description": "GetFullPage — capture an entire webpage as one image or PDF. 100% local, no account, no server, nothing uploaded.",
  "license": "MIT",
  "author": "One Million Lines (onemillionlines.com)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "node scripts/build.mjs --target=chrome --zip && node scripts/build.mjs --target=firefox --zip",
    "build:zip": "node scripts/build.mjs --zip",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/capture.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.278",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
